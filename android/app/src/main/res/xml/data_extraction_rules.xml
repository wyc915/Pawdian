<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules. Records and settings go to the user's Google
     account backup; photos are left out of cloud backup (25 MB quota) but
     are kept when moving to a new phone directly. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_flutter/pet_photos/" />
        <exclude domain="root" path="app_flutter/attachments/" />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
